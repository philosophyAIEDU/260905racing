{
  "name": "drivetalk",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite apps/web --config apps/web/vite.config.ts",
    "build": "turbo run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/three": "0.175.0",
    "@vitest/coverage-v8": "3.0.8",
    "eslint": "9.22.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.0",
    "prettier": "3.5.3",
    "turbo": "2.4.4",
    "typescript": "5.7.3",
    "typescript-eslint": "8.26.1",
    "vitest": "3.0.8",
    "@dimforge/rapier3d-compat": "0.15.0",
    "vite": "6.2.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": "prettier --write"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
